{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.menezes.dev/contracts/provider-gateway/v1/inference.schema.json",
  "title": "Provider Gateway Inference v1",
  "$defs": {
    "message": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["system", "user", "assistant"] },
        "content": { "type": "string" }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "inferenceRequest": {
      "type": "object",
      "properties": {
        "policy_profile": { "type": "string", "minLength": 1 },
        "task_class": { "type": "string", "minLength": 1 },
        "input": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
        "budget": {
          "type": "object",
          "properties": {
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "max_cost_usd": { "type": "number", "minimum": 0 }
          },
          "required": ["max_output_tokens"],
          "additionalProperties": false
        }
      },
      "required": ["policy_profile", "task_class", "input", "budget"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "inferenceResult": {
      "type": "object",
      "properties": {
        "output": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
        "route_id": { "type": "string", "minLength": 1 },
        "usage": { "$ref": "#/$defs/usage" },
        "finish_reason": { "type": "string", "minLength": 1 }
      },
      "required": ["output", "route_id", "usage"],
      "additionalProperties": false
    }
  }
}
